{
  "type": "object",
  "required": ["enabled", "when", "source"],
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Text Lua, compiled at save and executed only on watched changes. automation.skip(reason) records a skipped run."
    },
    "editor": {
      "type": "object",
      "description": "Optional visual editor draft; opaque to the board. Omit on raw replacement."
    },
    "when": {
      "description": "One property or 1–4 unique named property/minute inputs. Only these inputs wake the rule.",
      "oneOf": [
        {
          "type": "object",
          "required": ["device", "endpoint", "cluster", "property"],
          "properties": {
            "device": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "endpoint": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "cluster": {
              "type": "string",
              "minLength": 1,
              "maxLength": 39
            },
            "property": {
              "type": "string",
              "minLength": 1,
              "maxLength": 39
            }
          },
          "additionalProperties": false
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "device",
                  "endpoint",
                  "cluster",
                  "property",
                  "name"
                ],
                "properties": {
                  "device": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  },
                  "endpoint": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "cluster": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 39
                  },
                  "property": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 39
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,22}$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["name", "clock"],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,22}$"
                  },
                  "clock": {
                    "const": "minute"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      ]
    }
  }
}
